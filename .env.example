# Example environment variables for the Vite app

# Stub vs live API mode.
# true  → use contract-shaped stubs under src/stubs/
# false → call real APIs via axios (withCredentials)
VITE_USE_STUBS=true

# Base URL for real API endpoints (used when VITE_USE_STUBS=false)
VITE_API_BASE=https://api.example.com
