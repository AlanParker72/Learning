# Example environment variables for the Vite app

# Mock workflow dashboard API (role+tab+filters scoped). Set to "false" to hit real HTTP.
VITE_USE_MOCK_API=true

# Base URL for real API endpoints (used when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=/api

# Path param for list-on-load POST …/tasks/{task_id}/claim when no row task is selected.
# Defaults to "dashboard-list-{tab}" when unset.
# VITE_WORKFLOW_TASK_ID=dashboard-list
